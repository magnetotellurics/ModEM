{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },

    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_GENERATOR_TOOLSET": "fortran=ifx",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;MinSizeRel;RelWithDebInfo"
            },
            "environment": {
                "ONEAPI_ROOT": "C:/Program Files (x86)/Intel/oneAPI",
                "IFORT_COMPILER_ROOT": "C:/Program Files (x86)/Intel/oneAPI/compiler/latest",
                "MKLROOT": "C:/Program Files (x86)/Intel/oneAPI/mkl/latest",
                "I_MPI_ROOT": "C:/Program Files (x86)/Intel/oneAPI/mpi/latest",
                "MPI_HOME": "C:/Program Files (x86)/Intel/oneAPI/mpi/latest",
                "CUDA_PATH": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4",
                "HDF5_ROOT": "C:/Program Files/HDFGroup/HDF5/1.14.3",
                "PATH": "C:/Program Files (x86)/Intel/oneAPI/compiler/latest/bin/;C:/Program Files (x86)/Intel/oneAPI/mpi/latest/bin/;C:/Program Files (x86)/Intel/oneAPI/mkl/latest/bin/;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4/bin/;C:/Program Files/HDFGroup/HDF5/1.14.3/bin/;%PATH%",
                "LIB": "C:/Program Files (x86)/Intel/oneAPI/compiler/latest/lib;C:/Program Files (x86)/Intel/oneAPI/mkl/latest/lib;C:/Program Files (x86)/Intel/oneAPI/mpi/latest/lib/release_mt;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4/lib/x64;C:/Program Files/HDFGroup/HDF5/1.14.3/lib;%LIB%",
                "INCLUDE": "C:/Program Files (x86)/Intel/oneAPI/compiler/latest/include;C:/Program Files (x86)/Intel/oneAPI/mkl/latest/include;C:/Program Files (x86)/Intel/oneAPI/mpi/latest/include;C:/Program Files (x86)/Intel/oneAPI/mpi/latest/include/mpi;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4/include;C:/Program Files/HDFGroup/HDF5/1.14.3/include;%INCLUDE%",
                "CMAKE_PREFIX_PATH": "C:/Program Files (x86)/Intel/oneAPI/mkl/latest/lib/cmake;C:/Program Files (x86)/Intel/oneAPI/mpi/latest/lib/cmake/mpi;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.4;C:/Program Files/HDFGroup/HDF5/1.14.3/cmake;%CMAKE_PREFIX_PATH%"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },

 
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx",
                "CMAKE_Fortran_COMPILER": "ifx"
            },
